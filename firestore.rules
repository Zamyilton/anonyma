rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    match /submissions/{submissionId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['ownerUid','caption','category','createdAt','status'])
        && request.resource.data.keys().hasOnly(['ownerUid','caption','category','createdAt','status','mediaPath','mediaType'])
        && request.resource.data.status == 'pending'
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 1200
        && request.resource.data.category in ['Confessions','Photography','Memes','Videos','Random']
        && (
          request.resource.data.caption.size() > 0
          || (request.resource.data.keys().hasAll(['mediaPath','mediaType'])
            && request.resource.data.mediaPath is string
            && request.resource.data.mediaPath.matches('submissions/' + request.auth.uid + '/.*')
            && request.resource.data.mediaType.matches('(image/.*|video/.*)'))
        );
      allow read: if (resource.data.status == 'approved') || isAdmin();
      allow update, delete: if isAdmin();
    }
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['submissionId','reason','createdAt','reporterUid'])
        && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}